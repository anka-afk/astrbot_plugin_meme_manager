    "default": 2,
    "invisible": true
  },
  "emotions_probability": {
    "description": "旧版表情出现概率（兼容）",
    "type": "int",
    "default": 50,
    "invisible": true
  },
  "strict_max_emotions_per_message": {
    "description": "旧版严格限制表情数量（兼容）",
    "type": "bool",
    "default": true,
    "invisible": true
  },
  "emotion_llm_enabled": {
    "description": "旧版情感模型开关（兼容）",
    "type": "bool",
    "default": false,
    "invisible": true
