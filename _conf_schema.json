{
  "storage": {
    "description": "存储与图床",
    "type": "object",
    "hint": "新结构：优先使用此分组配置图床",
    "items": {
      "provider": {
        "description": "图床服务",
        "type": "string",
        "default": "cloudflare_r2",
        "options": ["stardots", "cloudflare_r2", "webdav"],
        "hint": "请选择要使用的图床服务"
      },
      "providers": {
        "description": "图床参数",
        "type": "object",
        "items": {
          "cloudflare_r2": {
            "description": "Cloudflare R2 配置",
            "type": "object",
            "items": {
              "account_id": {
                "description": "Cloudflare Account ID",
                "type": "string",
                "hint": "请输入 Cloudflare Account ID"
              },
              "access_key_id": {
                "description": "R2 Access Key ID",
                "type": "string",
                "hint": "请输入 R2 Access Key ID"
              },
              "secret_access_key": {
                "description": "R2 Secret Access Key",
                "type": "string",
                "hint": "请输入 R2 Secret Access Key"
              },
              "bucket_name": {
                "description": "R2 Bucket 名称",
                "type": "string",
                "hint": "请输入 R2 Bucket 名称"
              },
              "public_url": {
                "description": "自定义 CDN 域名（可选）",
                "type": "string",
                "default": "",
                "hint": "例如：https://cdn.yourdomain.com"
              }
            }
          },
          "webdav": {
            "description": "WebDAV 配置",
            "type": "object",
            "items": {
              "url": {
                "description": "WebDAV 地址",
                "type": "string",
                "hint": "例如：https://example.com/dav"
              },
              "username": {
                "description": "用户名",
                "type": "string",
                "hint": "请输入 WebDAV 用户名"
              },
              "password": {
                "description": "密码或应用密码",
                "type": "string",
                "hint": "请输入 WebDAV 密码或应用密码"
              },
              "base_path": {
                "description": "远端目录",
                "type": "string",
                "default": "memes",
                "hint": "表情包在 WebDAV 中保存的目录，例如：memes"
              },
              "public_url": {
                "description": "公开访问地址（可选）",
                "type": "string",
                "default": "",
                "hint": "如需生成外链，请填写公开访问根地址"
              },
              "verify_ssl": {
                "description": "校验 SSL 证书",
                "type": "bool",
                "default": true,
                "hint": "自签名证书服务可关闭此项"
              },
              "timeout": {
                "description": "请求超时时间（秒）",
                "type": "int",
                "default": 30,
                "hint": "WebDAV 上传、下载、列表请求的超时时间"
              }
            }
          },
          "stardots": {
            "description": "StarDots 配置",
            "type": "object",
            "items": {
              "key": {
                "description": "API Key",
                "type": "string",
                "hint": "请输入 StarDots 的 API Key"
              },
              "secret": {
                "description": "API Secret",
                "type": "string",
                "hint": "请输入 StarDots 的 API Secret"
              },
              "space": {
                "description": "空间名称",
                "type": "string",
                "default": "memes",
                "hint": "请输入 StarDots 的空间名称"
              },
              "list_cache_ttl": {
                "description": "远端列表缓存时长（秒）",
                "type": "int",
                "default": 60,
                "hint": "用于减少状态轮询时的 API 调用次数；0 表示关闭缓存",
                "slider": {
                  "min": 0,
                  "max": 300,
                  "step": 5
                }
              }
            }
          }
        }
      }
    }
  },
  "sync": {
    "description": "同步策略",
    "type": "object",
    "items": {
      "status_cache_ttl_seconds": {
        "description": "同步状态缓存时长（秒）",
        "type": "int",
        "default": 15,
        "hint": "管理页同步状态接口缓存；0 表示关闭缓存",
        "slider": {
          "min": 0,
          "max": 120,
          "step": 5
        }
      }
    }
  },
  "community": {
    "description": "社区资源安装",
    "type": "object",
    "items": {
      "github_accelerator_url": {
        "description": "GitHub 下载加速链接",
        "type": "string",
        "default": "https://ghfast.top/",
        "hint": "默认使用加速。留空后将回退 GitHub 原生链接。"
      }
    }
  },
  "semantic": {
    "description": "语义检索与图包语义化",
    "type": "object",
    "hint": "开启后默认使用 Tool 检索；若同时开启“情感辅助模型”，则由辅助模型接管。未达到 100% 语义化的图包会自动回退旧版分类模式",
    "items": {
      "enabled": {
        "description": "启用新版语义包检索",
        "type": "bool",
        "default": false,
        "hint": "默认向回复模型提供 search_memes Tool；开启情感辅助模型后改由该模型选图。不完整图包不会进入语义检索"
      },
      "top_k": {
        "description": "运行时：每次返回候选数",
        "type": "int",
        "default": 5,
        "hint": "只把少量候选交给回复模型或情感辅助模型"
      },
      "min_score": {
        "description": "运行时：最低相似度",
        "type": "float",
        "default": 0.25,
        "hint": "低于此值的结果不会返回"
      },
      "vision_provider_id": {
        "description": "语义化：视觉模型 Provider ID",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "一键完整语义化需要选择支持图片输入的聊天模型；留空时不能生成图片描述"
      },
      "embedding_provider_id": {
        "description": "语义化：Embedding 向量模型 Provider",
        "type": "string",
        "default": "",
        "_special": "select_provider_embedding",
        "hint": "可留空自动选择第一个可用的 Embedding 模型；实际选择的 Provider ID 会保存到本机 provider_selection.json"
      }
    }
  },
  "generation": {
    "description": "表情生成与发送",
    "type": "object",
    "items": {
      "emotion": {
        "description": "情感辅助与旧版分类回退",
        "type": "object",
        "items": {
          "llm": {
            "description": "情感模型辅助（开启后接管 Tool）",
            "type": "object",
            "hint": "语义图包完整时由该模型从新版语义候选中选图；图包不完整时自动改用旧版粗略分类标签",
            "items": {
              "enabled": {
                "description": "启用情感辅助模型",
                "type": "bool",
                "default": false,
                "hint": "开启后不再向回复模型提供 search_memes Tool，而是调用这里配置的模型完成选图"
              },
              "provider_id": {
                "description": "情感辅助模型 Provider ID（留空使用回复模型）",
                "type": "string",
                "default": "",
                "hint": "无需单独配置：留空时会自动复用本轮当前对话的回复模型；填写后才使用指定模型。此模型同时负责新版语义候选选择和旧版分类标签选择",
                "_special": "select_provider"
              },
              "context_turns": {
                "description": "注入给情感模型的上下文轮数",
                "type": "int",
                "default": 0,
                "hint": "0 表示不注入上下文；大于 0 时会把最近 N 轮对话追加到提示词末尾（用于提高缓存命中与语境一致性）",
                "slider": {
                  "min": 0,
                  "max": 10,
                  "step": 1
                }
              },
              "inject_persona": {
                "description": "向情感模型注入当前人格提示词",
                "type": "bool",
                "default": false,
                "hint": "开启后会把当前人格设定作为参考追加到提示词末尾，仅用于选图参考"
              }
            }
          },
          "max_per_message": {
            "description": "每次回复最多使用表情数量",
            "type": "int",
            "default": 2,
            "hint": "每次回复最多使用表情数量"
          },
          "probability": {
            "description": "表情出现概率",
            "type": "int",
            "default": 50,
            "hint": "语义 Tool 模式下，每轮按此概率决定是否注入并要求回复模型调用 search_memes，范围为 1-100",
            "slider": {
              "min": 1,
              "max": 100,
              "step": 5
            }
          },
          "strict_max_per_message": {
            "description": "严格限制表情数量",
            "type": "bool",
            "default": true,
            "hint": "开启后将严格裁剪超出数量的表情"
          }
        }
      },
      "prompt": {
        "description": "提示词模板",
        "type": "object",
        "hint": "类别描述会自动插入到提示词中",
        "items": {
          "head": {
            "description": "提示词前缀",
            "type": "text",
            "editor_mode": true,
            "editor_language": "markdown",
            "default": "\n\n你在对话中需根据当前情境智能选用表情符号，表情需用&&包裹，例如：&&happy&&, 通用格式:&&标签&&。选择逻辑遵循以下动态规则：\n\n[智能触发机制]\n1. 关键词匹配：当对话内容包含以下类型词汇时激活表情使用\n   - 核心情绪词（开心/生气/惊讶等）→ 直接匹配对应标签\n   - 场景特征词（早安/报酬/思考等）→ 关联场景标签\n   - 语气调节词（请/建议/但是等）→ 触发软化型表情\n2. 动态优先级：\n   a) 精确匹配现有标签 > 同义词扩展 > 放弃使用\n   b) 高频使用标签优先于低频标签\n\n[表情标签库]（当前可用）\n格式：标签 - 使用场景描述\n当前可用：\n",
            "hint": "请输入提示词头"
          },
          "tail_before_limit": {
            "description": "提示词后缀（数量前）",
            "type": "text",
            "editor_mode": true,
            "editor_language": "markdown",
            "default": "\n\n=== 安全控制体系 ===\n1. 使用频率：\n   • 日常对话：最多",
            "hint": "请输入提示词尾_1"
          },
          "tail_after_limit": {
            "description": "提示词后缀（数量后）",
            "type": "text",
            "editor_mode": true,
            "editor_language": "markdown",
            "default": "个表情\n   • 专业咨询：≤1个\n2. 强制校验规则：\n   a) 存在性检查：仅使用当前列表存在的标签\n   b) 冲突检测：当涉及医疗/法律/暴力话题时禁用所有表情\n   c) 语义一致性：表情含义需与上下文情绪方向一致\n3. 智能降级策略：\n   1) 首选：同类别表情或相近表情\n   2) 备选：放弃使用表情\n4. 自检流程：\n   提取关键词 → 匹配标签 → 语境审查 → 最终输出",
            "hint": "请输入提示词尾_2"
          }
        }
      },
      "markup": {
        "description": "标记解析策略",
        "type": "object",
        "items": {
          "enable_alternative": {
            "description": "启用备用标记",
            "type": "bool",
            "default": true,
            "hint": "允许将 :happy: 识别为 &&happy&&"
          },
          "remove_invalid_alternative": {
            "description": "移除无效备用标记",
            "type": "bool",
            "default": true,
            "hint": "会移除无法识别的 () 或 [] 标记内容；可能影响依赖此类标记的其他插件（例如好感度）（出现标签丢失时建议先关闭）"
          },
          "enable_repeated_detection": {
            "description": "启用重复表情检测",
            "type": "bool",
            "default": true,
            "hint": "防止输出 angryangryangry 这类重复标签"
          }
        }
      },
      "matching": {
        "description": "匹配增强",
        "type": "object",
        "items": {
          "enable_loose_matching": {
            "description": "启用宽松匹配",
            "type": "bool",
            "default": true,
            "hint": "中文场景建议开启，英文场景误匹配可关闭"
          },
          "high_confidence_emotions": {
            "description": "高置信度表情列表",
            "type": "list",
            "default": [
              "angry",
              "happy",
              "sad",
              "surprised",
              "confused",
              "color",
              "cpu",
              "fool",
              "givemoney",
              "like",
              "see",
              "shy",
              "work",
              "reply",
              "meow",
              "baka",
              "morning",
              "sleep",
              "sigh"
            ],
            "hint": "即使在英文上下文中也会优先识别这些标签"
          }
        }
      },
      "message": {
        "description": "消息发送策略",
        "type": "object",
        "items": {
          "convert_static_to_gif": {
            "description": "静态图转 GIF 发送",
            "type": "bool",
            "default": false,
            "hint": "开启后，发送静态图片时会转换为 1 帧 GIF"
          },
          "enable_mixed": {
            "description": "启用图文同条回复",
            "type": "bool",
            "default": false,
            "hint": "文本和表情图片在同一条消息中发送"
          },
          "mixed_probability": {
            "description": "图文同条回复概率",
            "type": "int",
            "default": 50,
            "hint": "启用图文同条时的发送概率，范围为 1-100",
            "slider": {
              "min": 1,
              "max": 100,
              "step": 5
            }
          },
          "streaming_compatibility": {
            "description": "流式传输兼容模式",
            "type": "bool",
            "default": true,
            "hint": "流式模式下将图片作为独立消息发送"
          },
          "send_image_as_base64": {
            "description": "以 Base64 发送图片",
            "type": "bool",
            "default": false,
            "hint": "开启后将把本地图片转换为 base64:// 再发送，适配不支持 file:// 的平台"
          },
          "content_cleanup_rule": {
            "description": "内容过滤正则表达式",
            "type": "string",
            "default": "&&[a-zA-Z]*&&",
            "hint": "移除分段后内容中的指定内容"
          }
        }
      }
    }
  },
  "prompt": {
    "description": "旧版提示词（兼容）",
    "type": "object",
    "items": {
      "prompt_head": {
