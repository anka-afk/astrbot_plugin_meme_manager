          "access_key_id": { "description": "Access Key ID", "type": "string" },
          "secret_access_key": {
            "description": "Secret Access Key",
            "type": "string"
          },
          "bucket_name": { "description": "Bucket 名称", "type": "string" },
          "public_url": {
            "description": "公开 URL",
