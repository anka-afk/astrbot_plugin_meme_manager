            "default": ""
          }
        },
        "invisible": true
      },
      "webdav": {
        "description": "WebDAV 旧版配置",
        "type": "object",
        "items": {
          "url": { "description": "WebDAV 地址", "type": "string" },
          "username": { "description": "用户名", "type": "string" },
          "password": { "description": "密码", "type": "string" },
          "base_path": {
            "description": "远端目录",
            "type": "string",
            "default": "memes"
          },
          "public_url": {
            "description": "公开 URL",
            "type": "string",
            "default": ""
          },
          "verify_ssl": {
            "description": "校验 SSL",
            "type": "bool",
            "default": true
          },
          "timeout": { "description": "超时秒数", "type": "int", "default": 30 }
        },
        "invisible": true
      }
