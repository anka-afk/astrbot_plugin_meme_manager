{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrbot.local/schemas/meme-pack-registry.schema.json",
  "title": "ASTRBOT Meme Pack Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "installed_packs"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "installed_packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/installedPack"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repo", "ref", "subpath"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["github"]
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 200
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subpath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+"
        }
      }
    },
    "installedPack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "enabled", "installed_at"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "installed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "$ref": "#/$defs/sourceDescriptor"
        }
      }
    }
  }
}
