{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrbot.local/schemas/meme-pack-community-index.schema.json",
  "title": "ASTRBOT Meme Pack Community Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "packs"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/communityPackEntry"
      }
    }
  },
  "$defs": {
    "sourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repo", "ref", "subpath"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["github"]
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 200
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subpath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+"
        }
      }
    },
    "previewUri": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "communityPackEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "maintainer",
        "description",
        "verified",
        "source",
        "previews",
        "license"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "maintainer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "verified": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/sourceDescriptor"
        },
        "previews": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/previewUri"
          },
          "uniqueItems": true,
          "maxItems": 32
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "uniqueItems": true,
          "maxItems": 32
        }
      }
    }
  }
}
